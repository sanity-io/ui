{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/docs": {},
    "apps/studio": {
      // The one-shot DS-276 docs export script is run via unrun, which knip
      // does not recognize as a script runner
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": [
        // Not imported by studio source, but must be a direct dependency so
        // vite can resolve it as an `optimizeDeps.exclude`d external from the
        // prebundled sanity/plugin chunks (see sanity.cli.ts)
        "@sanity/ui",
        // Never imported: `reactCompiler: {transform: 'oxc'}` in sanity.cli.ts
        // makes the sanity CLI load it as an optional peer of @sanity/cli,
        // which knip cannot trace through the `sanity` package
        "oxc-transform-react",
      ],
    },
  },
}
