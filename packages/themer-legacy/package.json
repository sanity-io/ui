{
  "name": "@sanity/themer-legacy",
  "version": "0.2.2",
  "description": "The hosted Themer service (themer.sanity.build) as an npm package: the exact same Sanity Studio theme generator, running locally, and a Studio tool to edit its themes.",
  "keywords": [
    "sanity",
    "studio",
    "theme",
    "themer",
    "ui"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/sanity-io/ui/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/ui.git",
    "directory": "packages/themer-legacy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tool": "./src/tool/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./tool": "./dist/tool.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@sanity/color": "workspace:^",
    "@sanity/icons": "workspace:^",
    "@sanity/ui": "^4.2.6",
    "react-compiler-runtime": "1.0.0"
  },
  "devDependencies": {
    "@sanity/tsdown-config": "catalog:",
    "@sanity/vanilla-extract-vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "oxc-transform-react": "catalog:",
    "react": "catalog:",
    "rimraf": "catalog:",
    "sanity": "catalog:",
    "styled-components": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "sanity": "^3 || ^4 || ^5 || ^6",
    "styled-components": "^5.2 || ^6"
  },
  "peerDependenciesMeta": {
    "sanity": {
      "optional": true
    },
    "styled-components": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
