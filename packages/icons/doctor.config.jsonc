{
  "rules": {
    // React Doctor's react preset restricts `forwardRef`/`createElement`
    // assuming a React 19-only project (ref-as-prop). This package publishes
    // with `peerDependencies.react: "^18 || ^19"`, so the generated icon
    // components must keep `forwardRef` for refs to attach on React 18 (see
    // the template comment in scripts/generate.ts).
    "eslint/no-restricted-imports": "off",
  },
  "ignore": {
    "overrides": [
      {
        // The icon components are generated from the design-exported SVG
        // sources in `export/` (scripts/generate.ts); path precision is owned
        // by the design export pipeline, not hand-tuned per component.
        "files": ["src/exports/**"],
        "rules": ["react-doctor/rendering-svg-precision"],
      },
    ],
  },
}
