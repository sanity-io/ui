{
  "name": "@sanity-labs/ui-poc",
  "version": "0.0.1-alpha.10",
  "description": "Sanity Design System POC",
  "keywords": [],
  "homepage": "https://github.com/sanity-labs/ui-poc#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/ui-poc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/ui-poc.git"
  },
  "license": "ISC",
  "author": "Sanity",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm run clean & pnpm run /^build:/",
    "build:css:components": "postcss src/components/index.css -o dist/components.css",
    "build:css:index": "postcss src/index.css -o dist/styles.css",
    "build:css:utilities": "postcss src/css/index.css -o dist/utilities.css",
    "build:js": "pkg build --strict --check",
    "clean": "rimraf dist",
    "dev": "pnpm run --parallel /^dev:/",
    "dev:css": "postcss src/index.css -o dist/styles.css --watch",
    "dev:js": "pkg watch",
    "format": "prettier --write --cache --ignore-unknown .",
    "lint": "eslint .",
    "test": "vitest run",
    "ts:check": "tsc --noEmit"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@sanity-labs/design-tokens": "0.0.2-alpha.2",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^9.2.3",
    "@sanity/tsconfig": "^1.0.0",
    "@types/postcss-import": "^14.0.3",
    "@types/react": "^19.2.14",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.22.0",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
