    "./breadcrumbs": "./src/exports/breadcrumbs.ts",
    "./code": "./src/exports/code.ts",
    "./menu": "./src/exports/menu.ts",
    "./popover": "./src/exports/popover.ts",
    "./theme": "./src/exports/theme.ts",
    "./toast": "./src/exports/toast.ts",
    "./tooltip": "./src/exports/tooltip.ts",
    "./styles.css": {
      "types": "./dist/styles-css.d.ts",
      "browser": "./dist/styles.css",
      "style": "./dist/styles.css",
      "node": "./dist/styles-css.js",
      "default": "./dist/styles-css.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./autocomplete": "./dist/autocomplete.js",
      "./breadcrumbs": "./dist/breadcrumbs.js",
      "./code": "./dist/code.js",
      "./menu": "./dist/menu.js",
      "./popover": "./dist/popover.js",
      "./theme": "./dist/theme.js",
      "./toast": "./dist/toast.js",
      "./tooltip": "./dist/tooltip.js",
      "./styles.css": {
        "types": "./dist/styles-css.d.ts",
        "browser": "./dist/styles.css",
        "style": "./dist/styles.css",
        "node": "./dist/styles-css.js",
        "default": "./dist/styles-css.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf dist",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@sanity/color": "workspace:^",
    "@sanity/icons": "workspace:^",
    "csstype": "^3.2.3",
    "motion": "^13.0.0",
    "react-is": "catalog:",
