    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/react-is": "catalog:",
    "@vanilla-extract/css": "^1.21.2",
    "babel-plugin-react-compiler": "catalog:",
    "jsdom": "^30.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
