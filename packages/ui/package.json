{
  "name": "@sanity-labs/ui-poc",
  "version": "0.0.1-alpha.22",
  "description": "Sanity Design System POC",
  "keywords": [],
  "homepage": "https://github.com/sanity-labs/ui-poc#readme",
  "bugs": {
    "url": "https://github.com/sanity-labs/ui-poc/issues"
  },
  "license": "ISC",
  "author": "Sanity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-labs/ui-poc.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:css && pnpm run build:js",
    "build:css": "NODE_ENV=production postcss src/index.css -o dist/styles.css",
    "build:js": "pkg build --strict --check",
    "clean": "rimraf dist",
    "dev": "concurrently -n css,js \"pnpm run dev:css\" \"pnpm run dev:js\"",
    "dev:css": "postcss src/index.css -o dist/styles.css --watch",
    "dev:js": "pkg watch",
    "sync-version": "node scripts/write-version.js",
    "test": "vitest run",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanity-labs/design-tokens": "0.0.2-alpha.4",
    "@sanity/icons": "^3.7.4",
    "clsx": "^2.1.1",
    "react-refractor": "^4.0.0"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "catalog:",
    "@sanity/tsconfig": "^1.0.0",
    "@types/node": "^25.5.2",
    "@types/postcss-import": "^14.0.3",
    "@types/postcss-prefix-selector": "^1.16.3",
    "@types/react": "catalog:",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "catalog:",
    "concurrently": "^9.2.1",
    "cssnano": "^8.0.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-prefix-selector": "^2.1.1",
    "postcss-selector-parser": "^7.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@10.17.0"
}
