{
  "extends": "../../tsconfig.settings.json",
  "include": [
    "./.storybook/**/*",
    "./scripts",
    "./stories",
    "./tests",
    "./typings",
    "./vitest.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    // scripts/ run under Node's type stripping, which needs the `.ts` extension on relative imports
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    // Setting "jsx" to anything but "preserve" is usually incorrect, but at the moment Storybook needs it
    "jsx": "react-jsx"
  }
}
