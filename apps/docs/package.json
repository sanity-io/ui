{
  "name": "sanity-ui-docs",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "imports": {
    "#app/*": "./src/app/*",
    "#lib/*": "./src/lib/*",
    "#context/*": "./src/context/*.tsx"
  },
  "scripts": {
    "build": "pnpm --filter @sanity/ui build && next build --turbopack",
    "dev": "pnpm --filter @sanity/ui build && next dev --turbopack",
    "e2e": "playwright test",
    "e2e:build": "pnpm --filter @sanity/ui build && EXPOSE_TESTING_API=1 next build --turbopack",
    "prepare": "next typegen && pnpm --filter @sanity/ui build",
    "start": "next start",
    "test": "vitest",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.10",
    "@codemirror/lang-javascript": "^6.2.5",
    "@lezer/highlight": "^1.2.5",
    "@sanity/icons": "catalog:",
    "@sanity/logos": "catalog:",
    "@sanity/ui": "workspace:*",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "lodash-es": "^4.18.1",
    "next": "^16.4.2",
    "pako": "^3.0.2",
    "prettier": "^3.9.10",
    "qs": "^6.16.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-refractor": "catalog:",
    "refractor": "catalog:",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@next/playwright": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/babel__standalone": "^7.1.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@types/qs": "^6.15.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
