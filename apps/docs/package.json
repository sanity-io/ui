{
  "name": "sanity-ui-docs",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "imports": {
    "#app/*": "./src/app/*",
    "#lib/*": "./src/lib/*",
    "#sanity.types": "./sanity.types.ts",
    "#context/*": "./src/context/*.tsx"
  },
  "scripts": {
    "build": "pnpm sanity:build && pnpm next:build",
    "dev": "pnpm run \"/:dev$/\"",
    "e2e": "playwright test",
    "e2e:build": "EXPOSE_TESTING_API=1 next build --turbopack",
    "embeddings:enable": "sanity datasets embeddings enable production --projection '{ filename, namedExport, tags, description }' --wait",
    "next:build": "next build --turbopack",
    "next:dev": "next dev --turbopack",
    "prepare": "next typegen",
    "sanity:build": "sanity build public/studio",
    "sanity:dev": "sanity dev",
    "schema:deploy": "sanity schema deploy",
    "start": "next start",
    "test": "vitest",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.8",
    "@codemirror/lang-javascript": "^6.2.5",
    "@lezer/highlight": "^1.2.3",
    "@sanity/client": "catalog:",
    "@sanity/code-input": "^7.3.3",
    "@sanity/color": "workspace:*",
    "@sanity/icons": "workspace:*",
    "@sanity/image-url": "^2.1.1",
    "@sanity/logos": "workspace:*",
    "@sanity/themer": "workspace:*",
    "@sanity/ui": "workspace:*",
    "@sanity/vision": "^6.9.1",
    "@sindresorhus/slugify": "^2.2.1",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "lodash-es": "^4.18.1",
    "next": "^16.3.0",
    "next-sanity": "^13.3.1",
    "pako": "^3.0.1",
    "prettier": "^3.9.6",
    "qs": "^6.15.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-refractor": "catalog:",
    "refractor": "catalog:",
    "sanity": "catalog:",
    "sanity-plugin-media": "^6.1.1",
    "server-only": "^0.0.1",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@next/playwright": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@sanity/vanilla-extract-vite-plugin": "catalog:",
    "@types/babel__standalone": "^7.1.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/qs": "^6.15.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "babel-plugin-react-compiler": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
