{
  "ignore": {
    "overrides": [
      {
        // `import 'server-only'` is the canonical Next.js guard for
        // server-only modules — the side-effect-only import is the point.
        "files": ["src/lib/sanity/token.ts"],
        "rules": ["import/no-unassigned-import"]
      },
      {
        // Generated by `sanity typegen`: the bare `import "@sanity/client"`
        // is required for the `declare module` augmentation to attach to the
        // module.
        "files": ["sanity.types.ts"],
        "rules": ["import/no-unassigned-import"]
      },
      {
        // The official styled-components SSR registry from the Next.js docs:
        // the `typeof window` branch renders identical DOM on the server and
        // during hydration (StyleSheetManager emits no DOM of its own) — it
        // only skips the server-only style collection on the client.
        "files": ["src/lib/styled/registry.tsx"],
        "rules": ["react-doctor/no-hydration-branch-on-browser-global"]
      },
      {
        // Plain `<img>` is deliberate here (also suppressed inline for
        // oxlint's nextjs/no-img-element): article images are already
        // CDN-optimized by Sanity's image pipeline, and the npm badge is a
        // dynamic external SVG that next/image would not optimize.
        "files": [
          "src/components/page/article/content/Image.tsx",
          "src/components/page/article/content/NpmPackageBadge.tsx"
        ],
        "rules": ["react-doctor/nextjs-no-img-element"]
      }
    ]
  }
}
