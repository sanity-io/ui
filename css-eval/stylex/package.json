{
  "name": "css-eval-stylex",
  "version": "0.0.0",
  "private": true,
  "description": "StyleX evaluation prototype for Sanity (SAPP-4639): a @sanity/ui-style Button published as a library, rendered twice (v1 + v2) on one page.",
  "type": "module",
  "scripts": {
    "setup": "pnpm install && pnpm build:libs",
    "build:libs": "node scripts/build-libs.mjs",
    "build:app": "vite build app",
    "dev": "vite app",
    "test": "playwright test",
    "typecheck": "tsc -p typecheck/tsconfig.json",
    "bench": "node scripts/bench.mjs",
    "measure": "node scripts/measure.mjs",
    "hazard": "node scripts/hazard-define-vars.mjs",
    "evidence": "pnpm build:libs && pnpm build:app && pnpm test && pnpm typecheck && pnpm hazard && pnpm bench && pnpm measure"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylex-button-v1": "link:./packages/button-v1",
    "stylex-button-v2": "link:./packages/button-v2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.64.0",
    "@sanity/tsdown-config": "0.28.8",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "lightningcss": "^1.30.1",
    "rolldown": "1.2.13",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "unplugin": "^2.3.11",
    "unrun": "0.3.1",
    "vite": "8.3.4"
  }
}
