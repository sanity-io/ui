{
  "name": "css-eval-next-yak",
  "private": true,
  "type": "module",
  "description": "Evaluation prototype: a @sanity/ui-style Button compiled with next-yak, built twice (v1/v2) and rendered on one page to test for class-name collisions.",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build && pnpm --filter ./app run build",
    "build:libs": "pnpm --filter './packages/*' run build",
    "build:unsafe": "pnpm --filter './packages/*' run build:unsafe",
    "build:tsdown": "pnpm --filter './packages/*' run build:tsdown",
    "test": "pnpm --filter ./app test",
    "typecheck": "tsc -p type-tests/tsconfig.json",
    "bench": "node --experimental-strip-types bench/compile-bench.ts",
    "sizes": "node --experimental-strip-types bench/sizes.ts"
  },
  "devDependencies": {
    "@swc/core": "catalog:",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "@yak-eval/ui-v1": "workspace:*",
    "lightningcss": "^1.33.0",
    "next-yak": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "1.2.13",
    "styled-components": "^6.5.3",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "yak-swc": "9.10.2"
  },
  "packageManager": "pnpm@12.11.2"
}
