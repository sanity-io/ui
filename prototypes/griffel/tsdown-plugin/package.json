{
  "name": "@css-eval/tsdown-plugin-griffel",
  "version": "0.0.0",
  "private": true,
  "description": "tsdown/rolldown plugin that precompiles Griffel makeStyles() calls with @griffel/transform (oxc) and emits either runtime-injected (__styles) or extracted (__css + styles.css) output",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@griffel/core": "^1.21.4",
    "@griffel/css-extraction-utils": "^1.1.1",
    "@griffel/transform": "^3.0.9",
    "@griffel/vite-plugin": "^1.0.1",
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.142.0",
    "oxc-walker": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "rolldown": "^1.2.13",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "rolldown": "*"
  }
}
