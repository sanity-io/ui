{
  "name": "@sanity-css-eval/button-linaria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@linaria/atomic": "^8.2.0",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wyw-in-js/processor-utils": "^2.5.0",
    "@wyw-in-js/rollup": "^2.5.1",
    "@wyw-in-js/shared": "^2.5.0",
    "@wyw-in-js/transform": "^2.5.1",
    "@wyw-in-js/vite": "^2.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "description": "Prototype: @sanity/ui-style Button built with Linaria (wyw-in-js) and published with its CSS",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./styles.css": "./dist/default/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:all": "WYW_FLAVOR=default tsdown && WYW_FLAVOR=namespaced tsdown && WYW_FLAVOR=atomic tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "build:vite": "vite build --config vite.lib.config.ts"
  },
  "peerDependencies": {
    "@linaria/atomic": "^8.2.0",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@tsdown/css": "^0.23.1",
    "postcss": "^8.5.30",
    "unrun": "^0.3.1",
    "vite": "^8.3.4"
  }
}
