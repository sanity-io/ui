import {defineConfig} from '@sanity/tsdown-config'
import type {UserConfig} from 'tsdown'

// Default library build: tsdown bundles the component source together with
// the Panda runtime from `styled-system/` (generated by `panda codegen`). The
// stylesheet is produced separately by `panda cssgen --outfile dist/styles.css`
// (see package.json#scripts.build), exactly like the "Consume without Panda"
// publishing path in Panda's docs — consumers import `<pkg>/styles.css` and
// never run Panda themselves.
const config: UserConfig = await defineConfig({
  entry: {index: './src/index.ts'},
  tsconfig: 'tsconfig.dist.json',
  // The eval compares the published contract across two versions, so keep the
  // `exports` field under our control (the wrapper would otherwise point the
  // local exports at source, which is what we do NOT want: the demo app must
  // consume the built dist like an npm consumer).
  exports: false,
  // `panda cssgen` writes dist/styles.css before tsdown runs (so publint can
  // validate the `./styles.css` export); don't let tsdown wipe it.
  clean: false,
  deps: {neverBundle: [/^react(\/|$)/, /^react-dom(\/|$)/]},
})

export default config
