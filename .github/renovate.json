{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["v2", "v3", "$default"],
  "extends": ["github>sanity-io/renovate-config"],
  "ignorePresets": ["github>sanity-io/renovate-config:group-non-major"],
  "packageRules": [
    {
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix",
      "rangeStrategy": "bump"
    },
    {
      "description": "v2 and v3 branches only receives production dependency updates",
      "matchBaseBranches": ["v2", "v3"],
      "matchDepTypes": ["devDependencies"],
      "enabled": false
    },
    {
      "description": "v2 and v3 branches should skip selected dependencies",
      "matchBaseBranches": ["v2", "v3"],
      "matchPackageNames": [
        "@sanity/styled-components",
        "@types/react",
        "@types/react-dom",
        "react",
        "react-dom",
        "pnpm",
        "pnpm/action-setup",
        "pnpm/setup",
        "@sanity/code-input",
        "next-sanity",
        "sanity-plugin-media",
        "@sanity/vision",
        "sanity",
        "styled-components",
        "actions/upload-artifact",
        "@sanity/icons",
        "renovatebot/github-action",
        "@sanity/functions",
        "@sanity/tsdown-config",
        "next",
        "@babel/standalone"
      ],
      "enabled": false
    },
    {
      "description": "v2 cannot bump refractor due to ESM requirenment",
      "matchPackageNames": ["refractor"],
      "matchBaseBranches": ["v2"],
      "allowedVersions": "<=4"
    },
    {
      "description": "v2 cannot bump refractor due to ESM requirenment",
      "matchPackageNames": ["react-refractor"],
      "matchBaseBranches": ["v2"],
      "allowedVersions": "<=2"
    },
    {
      "description": "v2 is in maintenance mode",
      "matchPackageNames": ["@sanity/ui-workshop"],
      "matchBaseBranches": ["v2"],
      "allowedVersions": "<=2"
    },
    {
      "description": "v2 is in maintenance mode",
      "matchPackageNames": ["cypress"],
      "matchBaseBranches": ["v2"],
      "allowedVersions": "<=13"
    },
    {
      "description": "v2 is in maintenance mode",
      "matchPackageNames": ["npm-run-all2", "vite"],
      "matchBaseBranches": ["v2"],
      "allowedVersions": "<=5"
    },
    {
      "description": "v2 cannot bump motion to v13",
      "matchPackageNames": ["motion"],
      "matchBaseBranches": ["v2"],
      "allowedVersions": "<13"
    },
    {
      "description": "v4 is upgrading storybook, do not update it elsewhere",
      "matchPackageNames": [
        "eslint-plugin-storybook",
        "@storybook/addon-a11y",
        "@storybook/addon-docs",
        "@storybook/addon-links",
        "@storybook/addon-themes",
        "@storybook/react",
        "@storybook/react-vite",
        "storybook"
      ],
      "matchBaseBranches": ["v2", "v3"],
      "allowedVersions": "<=8"
    }
  ]
}
